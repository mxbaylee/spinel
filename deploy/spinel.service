[Unit]
Description=Spinel private workspace
After=docker.service tailscaled.service network-online.target
Requires=docker.service tailscaled.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/spinel
EnvironmentFile=/etc/spinel/deploy.env
ExecStartPre=/usr/local/bin/node scripts/deploy/check.ts
ExecStart=/usr/bin/docker compose --env-file /etc/spinel/deploy.env -f deploy/compose.yaml up --detach
ExecStop=/usr/bin/docker compose --env-file /etc/spinel/deploy.env -f deploy/compose.yaml down
TimeoutStopSec=90

[Install]
WantedBy=multi-user.target
