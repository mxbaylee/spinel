+            }, closeTimeoutMs);
+          }),
+        ]);
+      } finally {
+        clearTimeout(force);
+        clearTimeout(timer);
+      }
+    })();
+    return closing;
+  };
+  const onAbort = () => {
+    if (!ready) fail('App startup cancelled.');
+    void close().catch((error: unknown) => fail('App cleanup failed.', error));
+  };
