+    await readiness;
+    assertHealthy();
+    return { close, assertHealthy, evidence, finished, failure };
+  } catch (original) {
+    return await withFixtureCleanup(async () => {
+      throw original;
+    }, close);
+  } finally {
+    clearTimeout(startupTimer);
+  }
+}
