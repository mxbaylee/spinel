+}
+
+/** Preserve the feature failure even when its required cleanup also rejects. */
+export async function withFixtureCleanup<T>(
+  work: () => Promise<T>,
+  cleanup: () => Promise<void>,
+): Promise<T> {
+  let value: T;
+  try {
+    value = await work();
+  } catch (original) {
+    try {
