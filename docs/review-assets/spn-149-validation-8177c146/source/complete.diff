+for (const status of [101, 401])
+  test(`post-revocation handshake status ${status} preserves the establishment boundary`, async (t) => {
+    const f = await fixture(t);
+    f.create('revoked');
+    f.open('revoked');
+    f.observer.beforeRevoke();
+    f.close('revoked');
+    f.create('new');
