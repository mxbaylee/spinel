+import { workerData, parentPort } from 'node:worker_threads';
+import { chmodSync, rmSync, statSync } from 'node:fs';
+import { join } from 'node:path';
+import { DatabaseSync, backup } from '../../../server/database.ts';
+import { FEEDBACK_LIMITS } from '../../shared/feedback.ts';
+import type { FeedbackPair } from '../../shared/feedback.ts';
+import type { DiagnosticsStatus } from '../../shared/diagnostics.ts';
+
+interface Input {
+  source: string;
+  directory: string;
+  id: string;
+  actorId: string;
+  generation: string;
+  createdAt: number;
+  build: string;
+  dropped: DiagnosticsStatus['dropped'];
+  retentionDays?: number;
+}
+const input = workerData as Input;
+const frozenPath = join(input.directory, 'snapshot.sqlite');
+const source = new DatabaseSync(input.source);
+try {
+  source.exec('PRAGMA cache_size=-1024; PRAGMA temp_store=FILE; PRAGMA busy_timeout=1000;');
+  // VACUUM INTO takes one consistent SQLite snapshot, including committed WAL rows.
+  // Only this stage touches the mutable live store; neither button reads it later.
+  await backup(source, frozenPath);
+  chmodSync(frozenPath, 0o600);
+} finally {
+  source.close();
+}
+if (statSync(frozenPath).size > 64 * 1024 * 1024) throw new Error('Source exceeded its bound.');
+const frozen = new DatabaseSync(frozenPath, { readOnly: true });
+try {
+  const generation = String(
+    frozen.prepare('SELECT generation FROM diagnostics_state WHERE singleton=1').get()?.generation,
+  );
+  if (generation !== input.generation) throw new Error('Collection changed.');
+  const window = frozen
+    .prepare(
+      'SELECT min(received_at) AS start,max(received_at) AS end FROM events WHERE actor_id=?',
+    )
+    .get(input.actorId)!;
+  if (window.start === null || window.end === null) {
+    parentPort!.postMessage({ state: 'empty', generation });
+  } else {
+    const start = Number(window.start),
+      end = Number(window.end);
+    const counts = frozen
+      .prepare(
+        `SELECT
+      count(*) AS system,
+      sum(CASE WHEN actor_id=? THEN 1 ELSE 0 END) AS user,
+      sum(CASE WHEN actor_id=? AND name!='feedback' THEN 1 ELSE 0 END) AS userObservations,
+      sum(CASE WHEN name!='feedback' THEN 1 ELSE 0 END) AS systemObservations
+      FROM events WHERE received_at BETWEEN ? AND ?`,
+      )
+      .get(input.actorId, input.actorId, start, end)!;
+    const limitations = [
+      'All means matching rows retained in this snapshot. Unsent browser queues and discarded observations are not included.',
+      'Historical completeness and expired or never-collected context are unknown.',
+      'Drop counters are global process-lifetime counters sampled before preparation, not loss measured for this user or time span.',
+      'Feedback survives observation expiry; an old report does not guarantee its original metrics still exist.',
+    ];
+    const pair: FeedbackPair = {
+      state: 'ready',
+      id: input.id,
+      actorId: input.actorId,
+      generation,
+      createdAt: input.createdAt,
+      expiresAt: input.createdAt + FEEDBACK_LIMITS.pairLifetimeMs,
+      window: { start, end },
+      counts: {
+        user: Number(counts.user),
+        system: Number(counts.system),
+        userObservations: Number(counts.userObservations),
+        systemObservations: Number(counts.systemObservations),
+      },
+      context: Number(counts.userObservations) === 0 ? 'feedback-only' : 'retained',
+      limitations,
+    };
+    const schema = frozen
+      .prepare(
+        "SELECT sql FROM sqlite_master WHERE type='table' AND name IN ('events','diagnostics_state') ORDER BY name",
+      )
+      .all();
+    if (schema.length !== 2) throw new Error('Invalid diagnostics source.');
+    const snapshot = frozen
+      .prepare('SELECT count(*) AS recordCount,max(received_at) AS latestReceivedAt FROM events')
+      .get()!;
+    for (const scope of ['user', 'system'] as const) {
+      const path = join(input.directory, `${scope}.sqlite`);
+      const output = new DatabaseSync(path);
+      try {
+        // New databases receive only matching rows. Copy-and-delete would leave
+        // excluded messages in free pages and violate the user export's scope.
+        output.exec('PRAGMA journal_mode=OFF; PRAGMA cache_size=-1024; PRAGMA temp_store=FILE;');
+        const pageSize = Number(output.prepare('PRAGMA page_size').get()?.page_size);
+        output.exec(
+          `PRAGMA max_page_count=${Math.floor(FEEDBACK_LIMITS.artifactBytes / pageSize)};`,
+        );
+        for (const row of schema) output.exec(String(row.sql));
+        output.prepare('ATTACH DATABASE ? AS frozen').run(frozenPath);
+        const filter =
+          scope === 'user'
+            ? 'actor_id=? AND received_at BETWEEN ? AND ?'
+            : 'received_at BETWEEN ? AND ?';
+        const parameters = scope === 'user' ? [input.actorId, start, end] : [start, end];
+        output
+          .prepare(`INSERT INTO events SELECT * FROM frozen.events WHERE ${filter}`)
+          .run(...parameters);
+        output.prepare('DETACH DATABASE frozen').run();
+        const actual = output
+          .prepare('SELECT count(*) AS count,coalesce(sum(byte_size),0) AS bytes FROM events')
+          .get()!;
+        if (Number(actual.count) !== pair.counts[scope]) throw new Error('Incomplete export.');
+        output
+          .prepare(
+            'INSERT INTO diagnostics_state(singleton,generation,logical_bytes) VALUES(1,?,?)',
+          )
+          .run(generation, Number(actual.bytes));
+        output.exec(
+          'CREATE TABLE export_manifest(singleton INTEGER PRIMARY KEY CHECK(singleton=1), details TEXT NOT NULL CHECK(json_valid(details))) STRICT; PRAGMA user_version=1;',
+        );
+        output.prepare('INSERT INTO export_manifest VALUES(1,?)').run(
+          JSON.stringify({
+            schemaVersion: 1,
+            diagnosticsSchemaVersion: 1,
+            snapshotId: pair.id,
+            generation,
+            createdAt: pair.createdAt,
+            selectedActorId: pair.actorId,
+            scope,
+            window: pair.window,
+            timeBasis: 'received_at; trusted server receipt; both endpoints inclusive',
+            inclusion:
+              scope === 'user'
+                ? 'every retained row attributed to selectedActorId'
+                : 'every retained row of every actor, including unattributed system rows, within window',
+            completeRetainedSelection: true,
+            historicalCompleteness: 'unknown',
+            rowCount: Number(actual.count),
+            counts: pair.counts,
+            context: pair.context,
+            snapshotWatermark: {
+              recordCount: Number(snapshot.recordCount),
+              latestReceivedAt: snapshot.latestReceivedAt,
+            },
+            build: input.build,
+            dropped: { scope: 'global process lifetime before preparation', values: input.dropped },
+            retention: {
+              feedback: 'until explicit truncate',
+              observationAgeTargetDays: input.retentionDays ?? null,
+              observations:
+                input.retentionDays === undefined
+                  ? 'no automatic expiry configured; prior deletion history unknown'
+                  : 'server receipt age target; bounded maintenance may lag; prior deletion history unknown',
+            },
+            limits: {
+              sourceBytes: 64 * 1024 * 1024,
+              artifactBytes: FEEDBACK_LIMITS.artifactBytes,
+              rowCap: null,
+            },
+            limitations,
+          }),
+        );
+        if (output.prepare('PRAGMA quick_check').get()?.quick_check !== 'ok')
+          throw new Error('Invalid export.');
+      } finally {
+        output.close();
+      }
+      chmodSync(path, 0o600);
+      if (statSync(path).size > FEEDBACK_LIMITS.artifactBytes)
+        throw new Error('Artifact exceeded its bound.');
+    }
+    parentPort!.postMessage(pair);
+  }
+} finally {
+  frozen.close();
+  // The pair's files are the immutable, complete filtered datasets. The source
+  // snapshot is not needed during the operator's five-minute download window.
+  rmSync(frozenPath, { force: true });
+}
diff --git a/src/server/diagnostics/feedback-exports.ts b/src/server/diagnostics/feedback-exports.ts
new file mode 100644
index 00000000..81e8a3ab
--- /dev/null
+++ b/src/server/diagnostics/feedback-exports.ts
@@ -0,0 +1,273 @@
+import { randomUUID } from 'node:crypto';
+import { chmodSync, mkdtempSync, rmSync, statfsSync } from 'node:fs';
+import { dirname, join } from 'node:path';
+import { Worker } from 'node:worker_threads';
+import type { DiagnosticsStatus } from '../../shared/diagnostics.ts';
+import { FEEDBACK_LIMITS } from '../../shared/feedback.ts';
+import type { FeedbackPair, FeedbackPreparation, FeedbackScope } from '../../shared/feedback.ts';
+import { DiagnosticsError } from './errors.ts';
+
+export interface FeedbackExportOwner {
+  actorId: string;
+  sessionHash: string;
+}
+interface Job {
+  id: string;
+  owner: FeedbackExportOwner;
+  directory: string;
+  controller: AbortController;
+  finished: Promise<void>;
+  cleanup?: Promise<void>;
+  pair?: FeedbackPair;
+  expiry?: NodeJS.Timeout;
+  sending: boolean;
+}
+
+/** One bounded preparation/retained pair/transfer; no live SQLite lock while idle. */
+export class FeedbackExports {
+  private job?: Job;
+  private readonly source: string;
+  private readonly build: string;
+  private readonly status: () => DiagnosticsStatus;
+  private readonly now: () => number;
+  constructor(source: string, build: string, status: () => DiagnosticsStatus, now: () => number) {
+    this.source = source;
+    this.build = build;
+    this.status = status;
+    this.now = now;
+  }
+  get busy() {
+    return !!this.job && (!this.job.pair || this.job.sending);
+  }
+  async prepare(
+    actorId: string,
+    owner: FeedbackExportOwner,
+    signal?: AbortSignal,
+  ): Promise<FeedbackPreparation> {
+    let state = this.status();
+    if (!state.available || !state.generation)
+      throw new DiagnosticsError(503, 'Diagnostics are unavailable.');
+    if (signal?.aborted) throw new DiagnosticsError(503, 'Feedback preparation was cancelled.');
+    const existing = this.job;
+    if (
+      existing &&
+      (existing.controller.signal.aborted ||
+        (existing.pair &&
+          (this.now() >= existing.pair.expiresAt || state.generation !== existing.pair.generation)))
+    )
+      await this.dispose(existing);
+    if (this.job) {
+      // Recover a lost ready acknowledgement without allocating another pair or
+      // silently moving its window. A different account/session has no such lease.
+      if (
+        this.job.pair &&
+        !this.job.sending &&
+        this.job.pair.actorId === actorId &&
+        this.job.owner.actorId === owner.actorId &&
+        this.job.owner.sessionHash === owner.sessionHash
+      )
+        return this.job.pair;
+      throw new DiagnosticsError(
+        409,
+        'A feedback download is already prepared. Close it before preparing another.',
+      );
+    }
+    // Expired-pair disposal awaited the worker. Recheck the shared admission
+    // boundary before creating another directory, since a generic export may
+    // have started during that await.
+    state = this.status();
+    if (!state.available || !state.generation)
+      throw new DiagnosticsError(503, 'Diagnostics are unavailable.');
+    if (state.exporting)
+      throw new DiagnosticsError(409, 'A diagnostics download is already active.');
+    if (signal?.aborted) throw new DiagnosticsError(503, 'Feedback preparation was cancelled.');
+    const volume = statfsSync(dirname(this.source));
+    if (volume.bavail * volume.bsize < FEEDBACK_LIMITS.stagingBytes + 256 * 1024 * 1024)
+      throw new DiagnosticsError(
+        503,
+        'There is not enough space to prepare complete feedback downloads.',
+      );
+    const directory = mkdtempSync(join(dirname(this.source), '.diagnostics-feedback-'));
+    chmodSync(directory, 0o700);
+    let finish!: () => void;
+    const job: Job = {
+      id: randomUUID(),
+      owner,
+      directory,
+      controller: new AbortController(),
+      finished: new Promise<void>((resolve) => {
+        finish = resolve;
+      }),
+      sending: false,
+    };
+    this.job = job;
+    const abort = () => job.controller.abort();
+    signal?.addEventListener('abort', abort, { once: true });
+    let worker: Worker | undefined;
+    let timeout: NodeJS.Timeout | undefined;
+    let diskCheck: NodeJS.Timeout | undefined;
+    const startedAt = this.now();
+    try {
+      worker = new Worker(new URL('./feedback-export-worker.ts', import.meta.url), {
+        workerData: {
+          source: this.source,
+          directory,
+          id: job.id,
+          actorId,
+          generation: state.generation,
+          createdAt: startedAt,
+          retentionDays: state.retentionDays,
+          build: this.build,
+          dropped: state.dropped,
+        },
+        resourceLimits: { maxOldGenerationSizeMb: 32, maxYoungGenerationSizeMb: 8 },
+      });
+      let result: FeedbackPreparation | undefined;
+      let failed = false;
+      const terminate = () => {
+        void worker!.terminate();
+      };
+      job.controller.signal.addEventListener('abort', terminate, { once: true });
+      timeout = setTimeout(abort, FEEDBACK_LIMITS.operationTimeoutMs);
+      timeout.unref();
+      diskCheck = setInterval(() => {
+        try {
+          const current = statfsSync(dirname(this.source));
+          if (current.bavail * current.bsize < 256 * 1024 * 1024) abort();
+        } catch {
+          abort();
+        }
+      }, 250);
+      diskCheck.unref();
+      try {
+        await new Promise<void>((resolve, reject) => {
+          worker!.on('message', (value: FeedbackPreparation) => {
+            result = value;
+          });
+          worker!.once('error', () => {
+            failed = true;
+          });
+          worker!.once('exit', (code) => {
+            if (code === 0 && !failed && !job.controller.signal.aborted && result) resolve();
+            else reject(new Error('Feedback preparation unavailable.'));
+          });
+          if (job.controller.signal.aborted) terminate();
+        });
+      } finally {
+        job.controller.signal.removeEventListener('abort', terminate);
+        finish();
+      }
+      if (job.controller.signal.aborted || this.status().generation !== state.generation)
+        throw new DiagnosticsError(410, 'Diagnostics changed. Prepare both downloads again.');
+      if (result!.state === 'empty') {
+        await this.dispose(job);
+        return result!;
+      }
+      job.pair = result as FeedbackPair;
+      if (this.now() >= job.pair.expiresAt)
+        throw new DiagnosticsError(410, 'Feedback downloads expired. Prepare both again.');
+      job.expiry = setTimeout(
+        () => {
+          void this.dispose(job).catch(() => {
+            /* Keep the cancelled lease occupied for cleanup retry. */
+          });
+        },
+        Math.max(1, job.pair.expiresAt - this.now()),
+      );
+      job.expiry.unref();
+      return job.pair;
+    } catch (error) {
+      // Worker construction can fail before its exit handler exists.
+      if (!worker) finish();
+      await this.dispose(job);
+      if (error instanceof DiagnosticsError) throw error;
+      throw new DiagnosticsError(
+        503,
+        'Complete feedback downloads could not be prepared. Try again.',
+      );
+    } finally {
+      if (timeout) clearTimeout(timeout);
+      if (diskCheck) clearInterval(diskCheck);
+      signal?.removeEventListener('abort', abort);
+    }
+  }
+  private owned(id: string, owner: FeedbackExportOwner) {
+    const job = this.job;
+    if (!job || job.id !== id)
+      throw new DiagnosticsError(
+        410,
+        'Feedback downloads expired or were cleared. Prepare both again.',
+      );
+    if (job.owner.actorId !== owner.actorId || job.owner.sessionHash !== owner.sessionHash)
+      throw new DiagnosticsError(404, 'Not found.');
+    if (
+      !job.pair ||
+      job.controller.signal.aborted ||
+      this.now() >= job.pair.expiresAt ||
+      this.status().generation !== job.pair.generation
+    ) {
+      void this.dispose(job).catch(() => {
+        /* Keep the cancelled lease occupied for cleanup retry. */
+      });
+      throw new DiagnosticsError(
+        410,
+        'Feedback downloads expired or were cleared. Prepare both again.',
+      );
+    }
+    return job;
+  }
+  download(id: string, owner: FeedbackExportOwner, scope: FeedbackScope) {
+    const job = this.owned(id, owner);
+    if (job.sending)
+      throw new DiagnosticsError(409, 'A feedback download is active. Wait for it to finish.');
+    job.sending = true;
+    return {
+      path: join(job.directory, `${scope}.sqlite`),
+      signal: job.controller.signal,
+      generation: job.pair!.generation,
+      expiresAt: job.pair!.expiresAt,
+      finish: async (cancelled: boolean) => {
+        job.sending = false;
+        if (cancelled) await this.dispose(job);
+      },
+    };
+  }
+  async cancel(id: string, owner: FeedbackExportOwner) {
+    const job = this.job;
+    if (!job || job.id !== id) return;
+    if (job.owner.actorId !== owner.actorId || job.owner.sessionHash !== owner.sessionHash)
+      throw new DiagnosticsError(404, 'Not found.');
+    await this.dispose(job);
+  }
+  /** Successful explicit truncate invalidates preparation, retained files and transfer. */
+  invalidate() {
+    if (this.job)
+      void this.dispose(this.job).catch(() => {
+        /* A cancelled lease cannot be downloaded or replaced. */
+      });
+  }
+  async close() {
+    if (this.job) await this.dispose(this.job);
+  }
+  private dispose(job: Job): Promise<void> {
+    if (job.cleanup) return job.cleanup;
+    job.controller.abort();
+    if (job.expiry) clearTimeout(job.expiry);
+    job.cleanup = (async () => {
+      await job.finished;
+      try {
+        rmSync(job.directory, { recursive: true, force: true });
+      } catch {
+        // Do not admit more staging space or silently leave an orphaned pair.
+        // Explicit cancel/close can retry; startup also removes interrupted pairs.
+        job.cleanup = undefined;
+        throw new DiagnosticsError(
+          503,
+          'Temporary feedback downloads could not be removed. Try closing them again.',
+        );
+      }
+      if (this.job === job) this.job = undefined;
+    })();
+    return job.cleanup;
+  }
+}
