{
  "name": "spinel",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test scripts/backlog/tests/*.test.ts scripts/deploy/*.test.ts scripts/dependencies/*.test.ts scripts/ci/*.test.ts && vitest run",
    "typecheck": "tsc -p .",
    "backlog:check": "node scripts/backlog/cli.ts check",
    "backlog:index": "node scripts/backlog/cli.ts index",
    "backlog:new": "node scripts/backlog/cli.ts new",
    "backlog:pr": "node scripts/backlog/cli.ts pr",
    "dev": "node --watch server/index.ts --dev",
    "build": "vite build",
    "storybook": "NODE_OPTIONS='--import ./.storybook/typescript-api.ts' storybook dev -p 6006",
    "build-storybook": "NODE_OPTIONS='--import ./.storybook/typescript-api.ts' storybook build -o storybook-static && node scripts/ci/storybook-identity.ts",
    "start": "node server/index.ts",
    "lint": "oxlint --deny-warnings . && npm run format:check",
    "format": "prettier --write web server src lib e2e .storybook scripts/screenshots.ts scripts/social-preview.ts scripts/passkey-check.ts scripts/e2e.ts scripts/e2e-https.ts scripts/deploy scripts/dependencies scripts/ci scripts/pdf-feasibility *.config.ts",
    "format:check": "prettier --check web server src lib e2e .storybook scripts/screenshots.ts scripts/social-preview.ts scripts/passkey-check.ts scripts/e2e.ts scripts/e2e-https.ts scripts/deploy scripts/dependencies scripts/ci scripts/pdf-feasibility *.config.ts",
    "setup": "node server/setup.ts",
    "passkey:check": "npm run build && node scripts/passkey-check.ts",
    "e2e": "npm run build && node scripts/e2e.ts",
    "postinstall": "node scripts/dependencies/patch-univer-core.ts",
    "screenshots": "node scripts/screenshots.ts"
  },
  "devDependencies": {
    "@napi-rs/canvas": "1.0.11",
    "@playwright/test": "1.64.1",
    "@storybook/react-vite": "10.3.5",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "6.1.2",
    "oxlint": "1.88.0",
    "pdfjs-dist": "6.4.299",
    "prettier": "3.9.10",
    "storybook": "10.3.5",
    "typescript": "7.0.2",
    "typescript-api": "npm:typescript@5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "ws": "8.22.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1152.0",
    "@base-ui/react": "1.9.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@simplewebauthn/browser": "14.0.0",
    "@simplewebauthn/server": "14.0.3",
    "@spinel/doc-formulas": "*",
    "@spinel/presence-ui": "^0.0.0",
    "@univerjs-pro/collaboration": "1.1.0",
    "@univerjs-pro/collaboration-client": "1.1.0",
    "@univerjs-pro/collaboration-client-ui": "1.1.0",
    "@univerjs-pro/collaboration-database-sqlite": "1.1.0",
    "@univerjs-pro/collaboration-endpoint": "1.1.0",
    "@univerjs-pro/collaboration-service": "1.1.0",
    "@univerjs-pro/collaboration-transport-node": "1.1.0",
    "@univerjs-pro/docs-print": "1.1.0",
    "@univerjs-pro/license": "1.1.0",
    "@univerjs-pro/sheets-print": "1.1.0",
    "@univerjs/core": "1.1.0",
    "@univerjs/docs": "1.1.0",
    "@univerjs/drawing": "1.1.0",
    "@univerjs/engine-formula": "1.1.0",
    "@univerjs/preset-docs-core": "1.1.0",
    "@univerjs/preset-docs-drawing": "1.1.0",
    "@univerjs/preset-docs-hyper-link": "1.1.0",
    "@univerjs/preset-sheets-core": "1.1.0",
    "@univerjs/preset-sheets-drawing": "1.1.0",
    "@univerjs/presets": "1.1.0",
    "@univerjs/protocol": "1.1.0",
    "@univerjs/sheets": "1.1.0",
    "express": "5.3.0",
    "libsql": "0.5.29",
    "lucide": "1.44.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "sharp": "0.35.5"
  },
  "workspaces": [
    "lib/*"
  ]
}
