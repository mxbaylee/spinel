{
  "name": "spinel",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test scripts/backlog/tests/*.test.ts && vitest run",
    "typecheck": "tsc -p .",
    "design": "node scripts/design-preview.ts",
    "backlog:check": "node scripts/backlog/cli.ts check",
    "backlog:index": "node scripts/backlog/cli.ts index",
    "backlog:new": "node scripts/backlog/cli.ts new",
    "backlog:pr": "node scripts/backlog/cli.ts pr",
    "dev": "node --watch server/index.ts --dev",
    "build": "vite build",
    "start": "node server/index.ts",
    "lint": "oxlint --deny-warnings . && npm run format:check",
    "format": "prettier --write web server src e2e scripts/passkey-check.ts *.config.ts",
    "format:check": "prettier --check web server src e2e scripts/passkey-check.ts *.config.ts",
    "passkey:check": "npm run build && node scripts/passkey-check.ts",
    "e2e": "npm run build && playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "6.1.2",
    "oxlint": "1.88.0",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@simplewebauthn/browser": "14.0.0",
    "@simplewebauthn/server": "14.0.3",
    "express": "5.3.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  }
}
